{
  "name": "credit-reputation-backend",
  "version": "0.1.0",
  "private": true,
  "description": "Credit Reputation Protocol — backend (Hono + viem + SQLite + Drizzle)",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts",
    "setup:roles": "tsx src/scripts/setup-roles.ts",
    "onchain:check": "tsx src/scripts/onchain-check.ts",
    "onchain:demo": "tsx src/scripts/onchain-demo.ts"
  },
  "dependencies": {
    "@hono/node-server": "^1.13.7",
    "better-sqlite3": "^11.8.1",
    "dotenv": "^16.4.7",
    "drizzle-orm": "^0.38.4",
    "hono": "^4.6.16",
    "viem": "^2.22.13",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.10.7",
    "drizzle-kit": "^0.30.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}

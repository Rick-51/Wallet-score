# ---- Server ----
PORT=8787

# ---- Database ----
DATABASE_PATH=./data/reputation.db

# ---- Blockchain ----
# One of: sepolia | ethereum | mainnet
NETWORK=sepolia
RPC_URL_SEPOLIA=https://ethereum-sepolia-rpc.publicnode.com
RPC_URL_ETHEREUM=https://eth.llamarpc.com

# ---- Optional: Etherscan API key (enables tx-history metrics: transactionCount,
#      first/last transaction time, active days). Leave empty to skip.
ETHERSCAN_API_KEY=

# ---- Admin ----
# Shared secret required via the `X-Admin-Key` header on /api/admin/* routes.
ADMIN_API_KEY=dev-admin-key

# ---- Aave V3 (Sepolia) ----
AAVE_POOL_SEPOLIA=0x6Ae43d3271ff6888e7Fc43Fd7321a503ff738951
# Scan starting block for Aave events (0 = from genesis; set to the Aave
# deployment block to speed up first analysis).
AAVE_START_BLOCK=3975368
# RPC getLogs block-range chunk size (some providers cap this lower).
LOG_CHUNK=50000

# ---- Stablecoin tokens for balance aggregation (Sepolia; optional) ----
USDC_SEPOLIA=
USDT_SEPOLIA=
DAI_SEPOLIA=

# ---- Creditcoin testnet / on-chain contracts ----
# RPC for the Creditcoin testnet (chainId 102031).
CREDITCOIN_RPC_URL=https://rpc.cc3-testnet.creditcoin.network
CREDITCOIN_PROOF_BUILDER_URL=https://prover.cc3-testnet.creditcoin.network

# Signer for on-chain writes (submitAssessment / submitEvidence / review).
# Use the deployer's key (owner = oracle) for the simplest setup; otherwise call
# setOracle() / addReviewer() first (see `npm run setup:roles`).
CREDITCOIN_PRIVATE_KEY=

# Hardhat deployment record (addresses + ABI paths). Leave as-is if the
# contract repo lives at ../smartContract.
DEPLOYMENT_FILE=../smartContract/deployments/creditcoin-testnet.json

# Optional overrides (defaults are read from DEPLOYMENT_FILE).
REGISTRY_ADDRESS=
DEMO_LENDING_ADDRESS=

# Creditcoin Testnet configuration (copy to `.env` and fill in your values).

# Public RPC endpoint (can be overridden; this is the default).
CREDITCOIN_RPC_URL=https://rpc.cc3-testnet.creditcoin.network

# Private key of the deployer account. Both "0x..." and bare hex work.
# Fund this account with testnet tCTC from the Creditcoin faucet before deploying.
CREDITCOIN_PRIVATE_KEY=
